    "import xarray as xr\n",
    "\n",
    "# Path to your GRIB file\n",
    "file_path = \"1950-1959.grib\"\n",
    "\n",
    "# Open the GRIB file using the cfgrib engine\n",
    "try:\n",
    "    ds = xr.open_dataset(file_path, engine=\"cfgrib\")\n",
    "    print(ds)\n",
    "except Exception as e:\n",
    "    print(f\"Error opening file: {e}\")\n"
   ]
